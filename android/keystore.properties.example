# Copy to android/keystore.properties (gitignored) and fill in.
# Generate the keystore once with (any JDK's keytool, e.g. Android Studio's):
#   keytool -genkeypair -v -keystore hineni-upload.jks -alias hineni-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep hineni-upload.jks OUT of git and back it up somewhere safe — it is the
# Play upload key for this app.
storeFile=hineni-upload.jks
storePassword=CHANGE_ME
keyAlias=hineni-upload
keyPassword=CHANGE_ME
