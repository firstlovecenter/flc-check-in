# Loaded only by `npm run build:mobile` (vite build --mode mobile).
# Points the native (Capacitor) app's same-origin API paths at the deployed
# Vercel app, where the /flc-graphql and /api/flc-auth proxies actually live.
# Safe to commit — this is the public production origin, not a secret.
VITE_API_ORIGIN=https://hineni.firstlovecenter.com
